{
  // Display name for this crew
  "name": "agriculturists",

  // Agents to include — each must have a matching agents/<name>.jsonc file
  "agents": ["judge_agent", "risk_averse_agent", "optimistic_agent"],

  // Task definitions — executed in order for sequential process
  "tasks": [
        {
      // Task identifier
      "name": "optimistic_analysis_task",

      // What the task should accomplish
      // Use {placeholder} inputs here; crewai run prompts for missing values
      //"description": "Question to analyze: {user_question}\n\nYou are the Optimistic Analyst. Your job is to estimate the likely outcome and the realistic upside for this question, based on what the historical data shows is typical.\n\nSteps:\n1. Identify the crop, location, time period, and measure (for example yield, area, production, or price) that the question is about.\n2. Use the agriculture_nl2sql tool to retrieve the relevant historical data. Pass it a plain-English question, never SQL, and ask one specific thing per call (for example, \"What was the cotton yield in Nanded district for each year in the last 10 years?\"). If the result is empty or not what you need, rephrase the question in plain English and ask again.\n3. Identify the central tendency and recurring patterns in the data: typical values, averages or medians, and the overall trend.\n4. Separate typical outcomes from exceptional ones. For each unusually good or bad value, judge whether it is part of a recurring pattern or an isolated event. Do not let rare negative outliers dominate the assessment unless the data shows they recur.\n5. Identify the conditions under which the outcome is favorable, and the evidence that those conditions hold. Do not assume favorable conditions without evidence.\n6. Estimate the realistic upside. State the assumptions behind every estimate and keep estimates clearly separate from facts retrieved from the database.\n7. State any gaps or limitations in the data openly rather than filling them in.\n\nBase every factual claim on data retrieved with the agriculture_nl2sql tool. Do not guess database values, do not invent information, and do not give a final decision. The final decision is made later by the Judge.",
      "description": "Question to analyze: {user_question}\n\nYou are the Optimistic Analyst. Your job is to estimate the likely outcome and the realistic upside for this question, based on what the historical data shows is typical.\n\nSteps:\n1. Identify the crop, location, time period, and measure (for example yield, area, production, or price) that the question is about.\n2. Use the mcp tool to retrieve the relevant historical data. Ask one specific thing per call (for example, \"What was the cotton yield in Nanded district for each year in the last 10 years?\"). If the result is empty or not what you need, rephrase the question in plain English and ask again.\n3. Identify the central tendency and recurring patterns in the data: typical values, averages or medians, and the overall trend.\n4. Separate typical outcomes from exceptional ones. For each unusually good or bad value, judge whether it is part of a recurring pattern or an isolated event. Do not let rare negative outliers dominate the assessment unless the data shows they recur.\n5. Identify the conditions under which the outcome is favorable, and the evidence that those conditions hold. Do not assume favorable conditions without evidence.\n6. Estimate the realistic upside. State the assumptions behind every estimate and keep estimates clearly separate from facts retrieved from the database.\n7. State any gaps or limitations in the data openly rather than filling them in.\n\nBase every factual claim on data retrieved with the agriculture_nl2sql tool. Do not guess database values, do not invent information, and do not give a final decision. The final decision is made later by the Judge.",

      // Clear definition of what the output should look like
      //"expected_output": "Return ONLY the requested JSON object. Use exactly the fields defined by output_pydantic. Do not add, remove, or rename fields. Use the available evidence to create an answer, and divide that answer into parts that would fill the fields defined by output_pydantic. Do not confuse fields from output_pydantic with the fields from other tasks. Do not use any tools simply for the output fields, you can fill NA in fields that are not needed for the answer.",
      "expected_output": "An optimistic, evidence-based analysis of the question \"{user_question}\", with these sections:\n- Historical data: the key values retrieved from the database (with years or periods) that answer the question.\n- Typical outcome: the central tendency and recurring pattern, and which values are outliers and why.\n- Favorable factors: the conditions under which the outcome is favorable, and the evidence for them.\n- Potential upside: a realistic estimate of the upside, with its assumptions stated.\n- Evidence: the database queries made and what they returned.\n- Uncertainty: data gaps, limitations, and assumptions.\n- Summary: a short summary of the optimistic view.\nAnswer the question as fully as the evidence allows and stay faithful to it. Do not use outside knowledge, do not invent information, and do not give a final decision.",

      // Optional task guardrail(s) validate output before completion
      // Use "guardrail" for one rule or "guardrails" for many
      // Failed guardrails retry up to guardrail_max_retries times
      // "guardrail": "Every factual claim needs context support.",
      // "guardrails": [
      //   "Every factual claim must be supported by context.",
      //   "The answer must match the expected output format."
      // ],
      //"guardrail_max_retries": 5,

      // Advanced task options:
      // Docs: https://docs.crewai.com/concepts/tasks
      // "type": "ConditionalTask",
      // "condition": { "python": "my_project.conditions.should_run" },
      //"output_pydantic": {"python": "schemas.OptimisticAnalysisOutput"},
      // "output_pydantic": null,
      // "response_model": null,
      // "converter_cls": { "python": "my_project.converters.CustomConverter" },
      // "markdown": false,
      // "input_files": { "brief": "data/brief.txt" },
      // "security_config": {},

      // Which agent handles this task
      "agent": "optimistic_agent"

      // "tools": [],
      // "human_input": false,
      // "async_execution": false
    },

    {
      // Task identifier
      "name": "risk_analysis_task",

      // What the task should accomplish
      // Use {placeholder} inputs here; crewai run prompts for missing values
      //"description": "Question to analyze: {user_question}\n\nYou are the Risk-Averse Analyst. Your job is to protect against downside risk: find what could make this option perform poorly and explain the conditions under which it would be unfavorable. You also receive the Optimistic Analyst's analysis as context.\n\nSteps:\n1. Identify the crop, location, time period, and measure (for example yield, area, production, or price) that the question is about.\n2. Use the agriculture_nl2sql tool to retrieve the relevant historical data. Pass it a plain-English question, never SQL, and ask one specific thing per call (for example, \"What was the cotton yield in Nanded district for each year in the last 10 years?\"). If the result is empty or not what you need, rephrase the question in plain English and ask again.\n3. Examine historical variability: poor years, declines, volatility, and how often and how badly outcomes fell below typical levels.\n4. Identify downside risks and adverse scenarios, including crop-specific, environmental, and market risks, but only where the data supports them.\n5. Review the Optimistic Analyst's claims. Point out where favorable conditions were assumed without evidence, where downside evidence was overlooked or dismissed as an outlier, or where an apparently attractive option could perform poorly. Note the findings you agree with.\n6. Do not treat missing information as favorable. List the important gaps in the evidence and the information that would be needed to close them.\n7. State the assumptions behind every estimate and keep estimates clearly separate from facts retrieved from the database.\n\nBase every factual claim on data retrieved with the agriculture_nl2sql tool. Do not guess database values, do not invent information, and do not give a final decision. Produce an evidence-based risk analysis for the Judge to evaluate.",
      "description": "Question to analyze: {user_question}\n\nYou are the Risk-Averse Analyst. Your job is to protect against downside risk: find what could make this option perform poorly and explain the conditions under which it would be unfavorable. You also receive the Optimistic Analyst's analysis as context.\n\nSteps:\n1. Identify the crop, location, time period, and measure (for example yield, area, production, or price) that the question is about.\n2. Use the mcp tool to retrieve the relevant historical data. Ask one specific thing per call (for example, \"What was the cotton yield in Nanded district for each year in the last 10 years?\"). If the result is empty or not what you need, rephrase the question in plain English and ask again.\n3. Examine historical variability: poor years, declines, volatility, and how often and how badly outcomes fell below typical levels.\n4. Identify downside risks and adverse scenarios, including crop-specific, environmental, and market risks, but only where the data supports them.\n5. Review the Optimistic Analyst's claims. Point out where favorable conditions were assumed without evidence, where downside evidence was overlooked or dismissed as an outlier, or where an apparently attractive option could perform poorly. Note the findings you agree with.\n6. Do not treat missing information as favorable. List the important gaps in the evidence and the information that would be needed to close them.\n7. State the assumptions behind every estimate and keep estimates clearly separate from facts retrieved from the database.\n\nBase every factual claim on data retrieved with the mcp tool. Do not guess database values, do not invent information, and do not give a final decision. Produce an evidence-based risk analysis for the Judge to evaluate.",

      // Clear definition of what the output should look like
      //"expected_output": "Return ONLY the requested JSON object. Use exactly the fields defined by output_pydantic. Do not add, remove, or rename fields. Use the available evidence to create an answer, and divide that answer into parts that would fill the fields defined by output_pydantic. Do not confuse fields from output_pydantic with the fields from other tasks. Do not use any tools simply for the output fields, you can fill NA in fields that are not needed for the answer.",
      "expected_output": "A risk-averse, evidence-based analysis of the question \"{user_question}\", with these sections:\n- Risk assessment: a short overall view of the downside (not a final decision).\n- Risk factors: each major risk or adverse scenario, with the data that supports it.\n- Risk level: low, moderate, or high, with the reasoning behind it.\n- Common findings: where you agree with the Optimistic Analyst, and where you disagree and why.\n- Additional information: the important gaps in the evidence and what data would be needed, or a statement that none is needed.\nAnswer the question as fully as the evidence allows and stay faithful to it. Do not use outside knowledge, do not invent information, and do not give a final decision.",

      // Optional task guardrail(s) validate output before completion
      // Use "guardrail" for one rule or "guardrails" for many
      // Failed guardrails retry up to guardrail_max_retries times
      // "guardrail": "Every factual claim needs context support.",
      // "guardrails": [
      //   "Every factual claim must be supported by context.",
      //   "The answer must match the expected output format."
      // ],
      //"guardrail_max_retries": 5,

      // Advanced task options:
      // Docs: https://docs.crewai.com/concepts/tasks
      // "type": "ConditionalTask",
      // "condition": { "python": "my_project.conditions.should_run" },
      //"output_pydantic": {"python": "schemas.RiskAnalysisOutput"},   // "output_pydantic": null,
      // "response_model": null,
      // "converter_cls": { "python": "my_project.converters.CustomConverter" },
      // "markdown": false,
      // "input_files": { "brief": "data/brief.txt" },
      // "security_config": {},

      // Which agent handles this task
      "agent": "risk_averse_agent",
      "context": ["optimistic_analysis_task"]

      // "tools": [],
      // "human_input": false,
      // "async_execution": false
    }
,
    {
      // Task identifier
      "name": "judge_task",

      // What the task should accomplish
      // Use {placeholder} inputs here; crewai run prompts for missing values
      //"description": "Question to answer: {user_question}\n\nYou are the impartial Judge. You receive the Optimistic and Risk-Averse analyses as context. Your job is to summarize the important findings from both, weigh them, and give the final answer to the question, or a reasonable range of answers.\n\nSteps:\n1. Summarize the key evidence and findings from each analysis.\n2. Compare their evidence and reasoning rather than simply choosing between their conclusions. Identify where they agree and where they disagree.\n3. For each important claim, decide whether it is supported by data retrieved from the database. Distinguish typical outcomes from exceptional or tail-risk scenarios.\n4. If an important disagreement or uncertainty cannot be resolved from the two analyses, use the agriculture_nl2sql tool to retrieve the needed data before concluding. Pass it a plain-English question, never SQL. Do not rely on general knowledge in place of the database.\n5. Give a final answer or a reasonable range of answers, even when the information is incomplete. You may make a reasoned estimate when the evidence supports one, but do not present an unsupported guess as fact. Decline to answer only if the information is genuinely insufficient for a meaningful assessment, and say why.\n6. Clearly separate established findings from estimates or inferences, state the assumptions behind your answer, and state your confidence when the information is limited.",
      "description": "Question to answer: {user_question}\n\nYou are the impartial Judge. You receive the Optimistic and Risk-Averse analyses as context. Your job is to summarize the important findings from both, weigh them, and give the final answer to the question, or a reasonable range of answers.\n\nSteps:\n1. Summarize the key evidence and findings from each analysis.\n2. Compare their evidence and reasoning rather than simply choosing between their conclusions. Identify where they agree and where they disagree.\n3. For each important claim, decide whether it is supported by data retrieved from the database. Distinguish typical outcomes from exceptional or tail-risk scenarios.\n4. If an important disagreement or uncertainty cannot be resolved from the two analyses, use the mcp tool to retrieve the needed data before concluding. Do not rely on general knowledge in place of the database.\n5. Give a final answer or a reasonable range of answers, even when the information is incomplete. You may make a reasoned estimate when the evidence supports one, but do not present an unsupported guess as fact. Decline to answer only if the information is genuinely insufficient for a meaningful assessment, and say why.\n6. Clearly separate established findings from estimates or inferences, state the assumptions behind your answer, and state your confidence when the information is limited.",

      // Clear definition of what the output should look like
      //"expected_output": "Return ONLY the requested JSON object. Use exactly the fields defined by output_pydantic. Do not add, remove, or rename fields. Use the available evidence to create an answer, and divide that answer into parts that would fill the fields defined by output_pydantic. Do not confuse fields from output_pydantic with the fields from other tasks. Do not use any tools simply for the output fields, you can fill NA in fields that are not needed for the answer.",
      "expected_output": "The final assessment of the question \"{user_question}\", with these sections:\n- Summary of evidence: the key data and findings from both analyses.\n- Comparison of perspectives: an impartial summary of the optimistic and risk-averse views, where they agree and disagree, and which claims the data supports.\n- Additional information retrieved: any extra database queries you ran and their results, or \"None\".\n- Key uncertainties: important gaps, assumptions, and your confidence level.\n- Final conclusion: the final answer or range of answers, clearly separating established findings from estimates.\nAnswer the question as fully as the evidence allows and stay faithful to it. Do not use outside knowledge and do not invent information.",

      // Optional task guardrail(s) validate output before completion
      // Use "guardrail" for one rule or "guardrails" for many
      // Failed guardrails retry up to guardrail_max_retries times
      // "guardrail": "Every factual claim needs context support.",
      // "guardrails": [
      //   "Every factual claim must be supported by context.",
      //   "The answer must match the expected output format."
      // ],
      //"guardrail_max_retries": 5,

      // Advanced task options:
      // Docs: https://docs.crewai.com/concepts/tasks
      // "type": "ConditionalTask",
      // "condition": { "python": "my_project.conditions.should_run" },
      //"output_pydantic": {"python" : "schemas.JudgeAnalysisOutput"},
      // "output_pydantic": null,
      // "response_model": null,
      // "converter_cls": { "python": "my_project.converters.CustomConverter" },
      // "markdown": false,
      // "input_files": { "brief": "data/brief.txt" },
      // "security_config": {},

      // Which agent handles this task
      "agent": "judge_agent",

      // Task outputs used as context
      "context": ["risk_analysis_task", "optimistic_analysis_task"]

      // "tools": [],
      // "human_input": false,
      // "async_execution": false
    }
  ],

  // Execution process
  // "sequential" — tasks run in order, each receiving prior task outputs
  // "hierarchical" — a manager agent delegates tasks (requires manager_llm)
  "process": "sequential",

  // Enable verbose logging during execution
  "verbose": true,

  // Enable crew memory — persists context and learnings across tasks
  "memory": true,

  // Automatically plan the execution strategy before running tasks
  // "planning": false,

  // LLM for the planning step (used when planning is true)
  // "planning_llm": "openai/gpt-4o",

  // LLM for the manager agent (required when process is "hierarchical")
  // "manager_llm": "openai/gpt-4o",

  // Crew-level LLM fields also accept object form for custom endpoints
  // "chat_llm": {"model": "llama3", "provider": "ollama", "base_url": "http://localhost:11434"},

  // Advanced crew options:
  // Docs: https://docs.crewai.com/concepts/crews
  // For hierarchical crews, manager_agent can reference an agents/<name>.jsonc file
  // that is not included in the "agents" list.
  // "manager_agent": "judge_agent",
  // "before_kickoff_callbacks": [{"python": "my_project.callbacks.before_kickoff"}],
  // "after_kickoff_callbacks": [{"python": "my_project.callbacks.after_kickoff"}],
  // "function_calling_llm": "openai/gpt-4o-mini",
  // "max_rpm": null,
