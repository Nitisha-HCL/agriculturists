{
  // Agent's role title — appears in prompts and logs.
  // You can use {placeholder} inputs in role, goal, or backstory.
  // Example: "role": "Senior {industry} Researcher"
  "role": "Judge_Agent",

  // Optional custom Agent subclass
  // "type": {"python": "my_project.agents.CustomAgent"},

  // The agent's primary objective
  "goal": "Synthesize the findings of the Optimistic and Risk-Averse analysts into a final answer or range of answers, and flag every unresolved need: each disagreement, gap, or uncertainty that the available evidence cannot settle.",

  // Background story that shapes the agent's personality and approach
  "backstory": "You are an impartial evaluator responsible for synthesizing the important points raised by other evaluators into a clear final summary. Based on the available evidence, provide a final answer or a reasonable range of answers whenever possible, even when the information is incomplete.\n\nClearly distinguish established information from estimates or inferences. State the assumptions underlying your answer and indicate your confidence when the available information is limited. You may make a reasoned estimate when sufficient evidence exists to support one, but do not present an unsupported guess as fact. Decline to provide an answer only when the available information is genuinely insufficient to make a meaningful assessment.\n\nYou do not query the database yourself. When an important disagreement or uncertainty cannot be settled from the analyses you have, do not guess and do not fill the gap with general knowledge. Use the ask_analyst tool to request the missing information from the right analyst (Optimistic_Agent for typical outcomes and upside, Risk_Averse_Agent for downside and variability), with one specific plain-English data question per request. Anything that still cannot be settled, flag as an unresolved need: say what is missing and why it matters to the answer.",

  // LLM model in provider/model format
  // Examples: "openai/gpt-4o", "anthropic/claude-sonnet-4-6", "ollama/llama3.3"
  // For custom endpoints or deployment-based providers, replace with:
  "llm": {"model": "qwen2.5:3b", "provider": "ollama", "base_url": "http://localhost:11434"},
  // "llm": {"deployment_name": "my-deployment", "provider": "azure", "api_version": "2024-10-21"},
  //"llm": "gemini/gemini-3.8-flash",

  // Override LLM used specifically for tool/function calling
  // "function_calling_llm": "openai/gpt-5.4-mini",

  // Tools available to this agent
  // Built-in: "SerperDevTool", "ScrapeWebsiteTool", "FileReadTool", etc.
  // Custom: "custom:my_tool" loads from tools/my_tool.py
  // No database tool: the Judge synthesizes, requests more information from
  // the analysts through ask_analyst, and flags what is still unresolved.
  "tools": ["custom:ask_analyst"],
  //"mcps": [
	// "https://arena-tarmac-shrill.ngrok-free.dev/mcp"
  //    ],
  // Optional agent-level guardrail — validates this agent's final output.
  // String guardrails are checked by an LLM and can reject/retry output.
  // Python refs must point to module-level functions/classes in trusted code.
  //"guardrail": {
  //  "python": "guardrails.validate_judge_agent_output"
  //},
  //"guardrail_max_retries": 5,

  // Advanced agent options:
  // Docs: https://docs.crewai.com/concepts/agents
  // "reasoning": true,
  // "max_reasoning_attempts": 3,
  // "planning_config": {
  //   "reasoning_effort": "medium",
  //   "llm": {"model": "deepseek-chat", "provider": "deepseek"}
  // },
  // "multimodal": false,
  // "allow_code_execution": false,
  // "code_execution_mode": "safe",
  // "knowledge_sources": [],
  // "knowledge_config": {},
  // "inject_date": true,
  // "date_format": "%Y-%m-%d",
  // "security_config": {},

  // Agent behavior settings
  "settings": {
    // Show detailed execution logs
    "verbose": false,

    // Allow this agent to delegate tasks to other agents in the crew
    "allow_delegation": false,

    // Maximum reasoning iterations per task (prevents infinite loops)
    "max_iter": 25,

    // Maximum tokens for agent's response generation
    // "max_tokens": null,

    // Maximum execution time in seconds
    // "max_execution_time": null,

    // Maximum LLM requests per minute (rate limiting)
    // "max_rpm": null,

    // Enable agent-level memory (persists across tasks)
    // "memory": false,

    // Cache tool results to avoid duplicate calls
    // "cache": true,

    // Auto-summarize context when it exceeds the LLM's context window
    // "respect_context_window": true,

    // Maximum retries on execution errors
    "max_retry_limit": 20,

    // Enable step-by-step planning before task execution
    "planning": false

    // Include system prompt in LLM calls
    // "use_system_prompt": true

  }
}
